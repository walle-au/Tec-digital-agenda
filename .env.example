# Copia este archivo como .env y llénalo. El .env NUNCA se comparte ni se sube a git.
TEC_USUARIO=tu_usuario@estudiantec.cr
TEC_CLAVE=tu_contraseña

# Opcional: avisos al celular con la app ntfy (elige un nombre difícil de adivinar, p. ej. tec-agenda-8f3k2q)
NTFY_TOPIC=

# Opcional: correo semanal (lunes 7:00). Con Gmail usa una "contraseña de aplicación", no tu clave normal.
SMTP_USUARIO=
SMTP_CLAVE=
# A quién mandarlo (si se deja vacío, a SMTP_USUARIO)
CORREO_PARA=
